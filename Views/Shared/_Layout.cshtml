<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HHA Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">HHA Management</a>
        <div class="navbar-nav">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a class="nav-link" asp-controller="Caregivers" asp-action="Index">Caregivers</a>
                <a class="nav-link" asp-controller="Patients" asp-action="Index">Patients</a>
                <a class="nav-link" asp-controller="Visits" asp-action="Index">Visits</a>
                <a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a>
            }
            else
            {
                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
            }
        </div>
    </div>
</nav>
<main class="container py-4">
    @RenderBody()
</main>
</body>
</html>
