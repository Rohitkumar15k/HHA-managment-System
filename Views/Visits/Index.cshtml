@model IEnumerable<VisitDto>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Visits</h2>
    <a class="btn btn-primary" asp-action="Create">Schedule Visit</a>
</div>
<table class="table table-striped">
<thead><tr><th>Caregiver ID</th><th>Patient ID</th><th>Date</th><th>Status</th><th>Notes</th></tr></thead>
<tbody>
@foreach (var item in Model)
{
<tr><td>@item.CaregiverId</td><td>@item.PatientId</td><td>@item.VisitDate.ToString("dd-MMM-yyyy HH:mm")</td><td>@item.Status</td><td>@item.Notes</td></tr>
}
</tbody>
</table>
